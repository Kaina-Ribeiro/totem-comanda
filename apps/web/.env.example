# Copy to .env.local.

# Core API base URL, without the /v2 prefix (contract/openapi.yaml).
#   Prism mock (npm run mock):  http://localhost:4010
CORE_API_URL=http://localhost:4010

# Where menu photos (/media/...) are fetched from and uploads go. The contract
# does not define /media yet; with the mock it is the mock's own port (Prism
# rejects /media and corrupts binary uploads).
CORE_MEDIA_URL=http://localhost:4020

# Where the kitchen event stream (SSE) is opened. Prism buffers whole responses,
# so with the mock it is the mock's own port; the kitchen falls back to polling.
CORE_STREAM_URL=http://localhost:4020

# Key that encrypts the device credentials cookie (32 random bytes, base64).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DEVICE_COOKIE_SECRET=

# Development only: the device /api/dev/core signs in as (a smoke test of the
# generated client). With the mock, the kiosk in apps/web/mock/state.ts.
DEV_DEVICE_ID=KIOSK-TBT-001
DEV_DEVICE_SECRET=

# Development only: control endpoint of the stateful mock (npm run mock), used by /dev/mock.
MOCK_CONTROL_URL=http://localhost:4020/__mock

# Back office test login against the mock (apps/web/mock/state.ts): dono@padaria.test
