{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "openapi-typescript ../../contract/openapi.yaml -o src/lib/core-api.d.ts",
    "mock": "node mock/server.ts",
    "lint:contract": "redocly lint ../../contract/openapi.yaml",
    "test": "vitest run",
    "analyze": "next analyze",
    "mock:raw": "prism mock ../../contract/openapi.yaml -p 4010"
  },
  "dependencies": {
    "next": "16.4.3",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.72.1",
    "@serwist/turbopack": "^9.5.13",
    "@stoplight/prism-cli": "^5.14.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13",
    "serwist": "^9.5.13",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
